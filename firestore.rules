// ──────────────────────────────────────────────────────────────
// Firestore Security Rules — Netflaxt News
// Copia/incolla in Firebase Console → Firestore → Rules
// Sostituire ADMIN_EMAIL se cambia.
// ──────────────────────────────────────────────────────────────
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'cretellamattia36@gmail.com';
    }

    // Stato dei servizi automatici (battito del poller live/notifiche).
    // Lo scrive solo il Worker con le credenziali di servizio, che non
    // passa da queste regole: da qui il permesso di scrittura è negato.
    match /sistema/{documento} {
      allow read: if isAdmin();
      allow write: if false;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ─── ARTICOLI ──────────────────────────────────
    match /articles/{articleId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Update: l'admin può tutto. Gli utenti loggati possono SOLO
      // modificare il campo reactionCounts (per increment contatori reazioni).
      allow update: if isAdmin()
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCounts']));

      // Reazioni: lettura pubblica, scrittura solo per il proprio doc
      match /reactions/{uid} {
        allow read: if true;
        allow write: if isSelf(uid);
      }

      // Commenti: lettura pubblica, creazione solo autenticati,
      // delete dall'autore o admin. Update per like / reply.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid;
        /* L'unica modifica prevista è il "mi piace". Prima bastava
           essere collegati per riscrivere QUALSIASI campo di QUALSIASI
           commento: si poteva cambiare il testo scritto da un altro, e
           il commento sarebbe rimasto a suo nome.
           Le risposte non passano di qui: sono commenti nuovi. */
        allow update: if isAdmin()
          || (isSignedIn()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']));
        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.uid == request.auth.uid);
      }
    }

    // ─── UTENTI ────────────────────────────────────
    match /users/{uid} {
      /* Il singolo profilo resta leggibile: serve a mostrare nome e
         foto accanto a messaggi, commenti e pronostici.
         L'ELENCO no. Con `read: if true` era possibile chiedere l'intera
         collection e ottenere in un colpo solo i dati di tutti gli
         iscritti — nome, cognome, storico delle sanzioni, dispositivi
         collegati — senza nemmeno avere un account. Provato in
         produzione il 24/08/2026: funzionava davvero.
         ⚠️ Non rimettere `allow read`: comprende anche gli elenchi.
         La classifica, che era l'unica pagina pubblica ad avere bisogno
         dell'elenco, ora legge dalla collection `classifica`. */
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid) || isAdmin();
      allow delete: if isSelf(uid) || isAdmin();

      // Bookmarks: SOLO il proprietario può leggere/scrivere
      match /bookmarks/{articleId} {
        allow read, write: if isSelf(uid);
      }

      // Quiz giornaliero: SOLO il proprietario
      match /quizDays/{day} {
        allow read, write: if isSelf(uid);
      }

      // Dispositivi collegati: SOLO il proprietario può leggere/scrivere.
      // Quando un device viene cancellato dall'utente, l'altro device
      // se ne accorge in real-time e fa signOut automatico.
      match /devices/{deviceId} {
        allow read, write: if isSelf(uid);
      }
    }

    // ─── CLASSIFICA (voce pubblica di ogni tifoso) ─
    /* Contiene SOLO ciò che la classifica mostra: un nome, una foto e i
       punti del quiz. Esiste perché la classifica è pubblica e prima si
       costruiva leggendo l'elenco completo degli iscritti, che portava
       con sé anche i dati personali. Ciascuno scrive solo la propria
       voce, e solo questi campi. */
    match /classifica/{uid} {
      allow read: if true;
      allow create, update: if isAdmin()
        || (isSelf(uid)
            && request.resource.data.keys()
                 .hasOnly(['nome', 'foto', 'puntiQuiz', 'quizGiocati', 'aggiornatoIl']));
      allow delete: if isAdmin() || isSelf(uid);
    }

    // ─── DISPOSITIVI COLLEGATI ALLE NOTIFICHE ──────
    /* Fuori dal profilo pubblico: dall'elenco si capiva quanti
       dispositivi ha una persona, di che tipo e con che sistema — un
       identikit che non serve a nessuno tranne al diretto interessato.
       Il servizio che spedisce le notifiche legge con credenziali
       proprie e non passa da queste regole. */
    match /tokenDispositivi/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isSelf(uid);
      allow delete: if isSelf(uid) || isAdmin();
    }

    // ─── MODERAZIONE (stato sanzioni di ogni utente) ─
    /* Fuori dal profilo, che è pubblico: motivo della sanzione, numero
       di ban e messaggi segnalati sono informazioni sul comportamento
       di una persona e non devono essere consultabili da chiunque.
       Leggono solo l'interessato e l'amministratore.

       ⚠️ La scrittura resta permessa all'interessato, e non è una
       svista: senza un server, la sanzione la registra il browser di
       chi ha commesso la violazione — non c'è nessun altro che possa
       farlo. Chi ha competenze tecniche può quindi annullarsela.
       Per impedirlo davvero servirebbe il piano a pagamento di Firebase.
       Vedi la nota in cima a utils/moderationService.js. */
    match /moderazione/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isSelf(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── PAGELLE (voti dei tifosi ai giocatori) ────
    /* Il documento della partita contiene chi ha giocato e due totali
       per giocatore — somma dei voti e numero di votanti — da cui esce
       la media. Sono pubblici: la media è il senso della cosa.

       L'elenco dei giocatori lo scrive il servizio automatico a fine
       gara, con credenziali proprie: da qui nessuno può cambiarlo.
       Chi è collegato può solo aggiornare i totali, ed è quello che
       fa votando. */
    match /pagelle/{partita} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['somme', 'conteggi', 'senzaVoto']));

      /* I voti di una persona stanno in un documento che porta il suo
         nome: votare due volte sovrascrive invece di raddoppiare, e
         nessuno può scrivere al posto di un altro.
         Restano leggibili solo all'interessato: la media è pubblica,
         le pagelle del singolo no. */
      match /voti/{uid} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if isSelf(uid);
        allow delete: if isAdmin();
      }
    }

    // ─── CONTATTI (indirizzi email degli account) ──
    /* Tenuti fuori dal profilo, che è pubblico. Li legge l'interessato,
       l'amministratore e il servizio automatico che spedisce le email
       (quest'ultimo usa credenziali proprie e non passa di qui). */
    match /contattiUtenti/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['email', 'aggiornatoIl']);
      allow delete: if isSelf(uid) || isAdmin();
    }

    // ─── PRONOSTICI ────────────────────────────────
    match /predictions/{predId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      /* In aggiornamento va verificato ANCHE il proprietario di quello
         che c'è già. Controllando solo i dati in arrivo, chiunque poteva
         sovrascrivere il pronostico di un altro semplicemente mettendoci
         il proprio identificativo. */
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ─── PARTITE ───────────────────────────────────
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── SONDAGGI ──────────────────────────────────
    match /polls/{pollId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Update: l'admin può tutto. Gli utenti loggati possono solo
      // modificare optionCounts e/o totalVotes (per incrementare il voto).
      allow update: if isAdmin()
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['optionCounts', 'totalVotes']));

      // Voti: lettura solo dell'utente stesso, scrittura solo per il proprio doc
      match /votes/{uid} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isSelf(uid);
      }
    }

    // ─── SEGNALAZIONI ──────────────────────────────
    match /reports/{reportId} {
      // Crea: chiunque sia loggato; il reporter deve essere lo user corrente
      allow create: if isSignedIn()
        && request.resource.data.reporter.uid == request.auth.uid;
      // Lettura/aggiornamento/eliminazione: solo admin
      allow read, update, delete: if isAdmin();
    }

    // ─── CODA PUSH ─────────────────────────────────
    match /pushQueue/{id} {
      allow read, write: if isAdmin();
    }

    // ─── NEWSLETTER: messaggi in partenza ──────────
    // Solo l'admin scrive qui; il servizio automatico che li spedisce
    // usa le credenziali di servizio e non passa da queste regole.
    match /newsletterQueue/{id} {
      allow read, write: if isAdmin();
    }

    // ─── NEWSLETTER ────────────────────────────────
    // L'indirizzo email è anche l'id del documento: così l'iscrizione
    // doppia viene rifiutata da sola (sarebbe una modifica, non una
    // creazione) senza dover rendere leggibile l'elenco.
    // La lettura resta al solo admin: sono dati personali di terzi.
    match /newsletter/{indirizzo} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.email is string
        && request.resource.data.email.size() < 200
        && request.resource.data.keys().hasOnly(['email', 'createdAt', 'confirmed', 'source']);
    }

    // ─── MODERAZIONE (ricorsi al ban) ──────────────
    // Il codice salva il campo `uid` (non `userId`). Le rules devono
    // coincidere altrimenti la create/read falliscono.
    match /appeals/{id} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
