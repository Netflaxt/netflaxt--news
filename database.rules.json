{
  "rules": {
    "messages": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email == 'cretellamattia36@gmail.com'",
      ".indexOn": ["timestamp"],
      "$msgId": {
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('uid').val() == auth.uid) || auth.token.email == 'cretellamattia36@gmail.com')",
        "reactions": {
          "$emoji": {
            "$reactUid": {
              ".write": "auth != null && auth.uid == $reactUid"
            }
          }
        }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "typing": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "meta": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email == 'cretellamattia36@gmail.com'"
    }
  }
}
